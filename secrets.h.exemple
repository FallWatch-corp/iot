// secrets.h.exemple : MODÈLE du fichier Wi-Fi du bracelet FallGuard (ESP32 DevKit)
//
// Le vrai mot de passe Wi-Fi ne doit PAS être sur GitHub ni dans la remise :
// il va dans un fichier secrets.h, ignoré par git (.gitignore).
//
// Utilisation :
//   1. Copier ce fichier dans le dossier du croquis (fallguard_esp32_serie_1/)
//      et le renommer secrets.h.
//   2. Remplacer les deux valeurs ci-dessous par le nom et le mot de passe du réseau Wi-Fi
//      (réseau 2,4 GHz : l'ESP32 ne capte pas le 5 GHz).
//   3. Téléverser fallguard_esp32_serie_1.ino.
//
// Le Wi-Fi sert à obtenir l'heure (affichée sur l'OLED). La localisation par balises
// fonctionne même sans Wi-Fi : si WIFI_SSID reste "VOTRE_SSID", le bracelet saute la connexion.

#define WIFI_SSID "VOTRE_SSID"                  // nom du réseau Wi-Fi
#define WIFI_MOT_DE_PASSE "VOTRE_MOT_DE_PASSE"  // mot de passe du réseau Wi-Fi
